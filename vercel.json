{
  "version": 2,
  "framework": null,
  "buildCommand": "node scripts/build-app.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/tts.js": {
      "maxDuration": 60
    },
    "api/tts-script.js": {
      "maxDuration": 60
    },
    "api/tts-voices.js": {
      "maxDuration": 60
    },
    "api/account.js": {
      "maxDuration": 60
    },
    "api/cron-billing.js": {
      "maxDuration": 60
    },
    "api/sns.js": {
      "maxDuration": 60
    },
    "api/cron-sns.js": {
      "maxDuration": 60
    },
    "api/trends.js": {
      "maxDuration": 60
    },
    "api/generate-script.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/intro",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/studio.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/shorts/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    },
    {
      "source": "/assets/remix/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    },
    {
      "source": "/(admin|admin\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(studio|studio\\.html|index\\.html|trends-today\\.json)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/app/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/trends?specialtyCron=1",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron-billing",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron-sns",
      "schedule": "0 2 * * *"
    }
  ]
}
